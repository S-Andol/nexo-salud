# Copy this file to `.env` (not `.env.local`) — that's the single file Next.js,
# the Prisma CLI, Prisma Migrate, and Prisma Client (used by prisma/seed.ts) all
# auto-load, so there's exactly one place to edit when a credential changes.

# Pooled PostgreSQL connection string (Neon), used at runtime by the app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Unpooled/direct connection string (Neon), used only by Prisma Migrate for DDL —
# migrations and the exclusion constraints don't work reliably through a pooler.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Shows the demo account credentials banner on the login page. Set to "true" only
# in local/demo environments, never in a real production deploy.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="true"
